module

public import Mathlib.RingTheory.Ideal.Prod

/-!
# Kernels of projections from product semirings

The kernel of the first projection is generated by the complementary idempotent `(0, 1)`.
-/

public section

namespace RingHom

/-- The first projection of a product has kernel generated by the idempotent `(0, 1)`. -/
theorem ker_fst_eq_span (R S : Type*) [Semiring R] [Semiring S] :
    ker (fst R S) = Ideal.span {((0, 1) : R × S)} := by
  ext ⟨a, b⟩
  simp only [mem_ker, coe_fst, Ideal.mem_span_singleton']
  refine ⟨fun ha => ⟨(0, b), by simp [ha]⟩, fun ⟨⟨_, c⟩, hc⟩ => ?_⟩
  simpa using (congrArg Prod.fst hc).symm

end RingHom
