module

public import TauCeti.RingTheory.Henselization.Lift
import TauCeti.RingTheory.Henselization.Jacobson
import Mathlib.Algebra.Field.ZMod
import TauCeti.RingTheory.Etale.Idempotent

/-!
# Boundary checks for henselization

These are the remaining checks of TauCetiRoadmap/SchemeAndStackFoundations/README.md, §0.12:
the unit-ideal henselization vanishes, the first projection of the split étale algebra over F₅
has selector (1, 0) and complementary kernel (0, 1), and X² − 1 over F₂ has a nonsimple root.
-/

public section

open Polynomial

namespace TauCeti.Examples.Henselization

/-- Henselization along the unit ideal is the zero ring. -/
theorem unit_ideal (R : Type*) [CommRing R] :
    Subsingleton (TauCeti.Henselization.algebra (⊤ : Ideal R)) := by
  apply not_nontrivial_iff_subsingleton.mp
  intro h
  let := h
  have hle := TauCeti.Henselization.extended_le_jacobson (⊤ : Ideal R)
  simp only [TauCeti.Henselization.extended, Ideal.map_top] at hle
  exact bot_ne_top (Ideal.jacobson_eq_top_iff.mp (top_le_iff.mp hle))

/-- The first-factor selector in F₅ × F₅ is idempotent. -/
theorem etale_section_idempotent : IsIdempotentElem ((1, 0) : ZMod 5 × ZMod 5) := by
  ext <;> simp

/-- The first projection has kernel generated by the complementary idempotent (0, 1). -/
theorem etale_section_kernel : RingHom.ker (RingHom.fst (ZMod 5) (ZMod 5)) =
    Ideal.span {((0, 1) : ZMod 5 × ZMod 5)} := by
  ext ⟨a, b⟩
  simp only [RingHom.mem_ker, RingHom.coe_fst, Ideal.mem_span_singleton']
  refine ⟨fun ha => ⟨(0, b), by simp [ha]⟩, fun ⟨⟨_, c⟩, hc⟩ => ?_⟩
  simpa using (congrArg Prod.fst hc).symm

/-- Over F₂, 1 is a root of X² − 1 whose derivative is not a unit. -/
theorem derivative_not_unit : ((X ^ 2 - 1 : (ZMod 2)[X]).eval 1 = 0) ∧
    ¬ IsUnit ((X ^ 2 - 1 : (ZMod 2)[X]).derivative.eval 1) := by
  norm_num
  decide

/-- The split two-factor algebra over F₅ is étale. -/
theorem split_product_etale : Algebra.Etale (ZMod 5) (ZMod 5 × ZMod 5) :=
  TauCeti.Algebra.Etale.prod

/-- Multiplication by the selector retains exactly the first component. -/
theorem etale_section_selector (a b : ZMod 5) :
    ((1, 0) : ZMod 5 × ZMod 5) * (a, b) = (a, 0) := by simp

/-- The first projection sends its selector to 1. -/
theorem etale_section_selector_image :
    RingHom.fst (ZMod 5) (ZMod 5) ((1, 0) : ZMod 5 × ZMod 5) = 1 := rfl

end TauCeti.Examples.Henselization
