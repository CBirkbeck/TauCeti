module

public import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.KrullDimension
public import TauCeti.RingTheory.PowerSeries.Weierstrass.Quotient
public import Mathlib.NumberTheory.Padics.PadicNumbers

/-!
# Quotient checks for Tate algebras

These examples identify the zero-variable algebra,
compute the one-variable dimension and linear quotients, include the zero quotient by 1, and
construct the basis 1, X of Q_p⟨X⟩/(X²-p) with its quadratic relation. The companion
`Examples/RingTheory/MvPowerSeries/TateAlgebra/Expand.lean` supplies the radius-√p presentation.

The quadratic basis transports Mathlib’s `AdjoinRoot.powerBasis` through
`IsDistinguished.polynomialQuotientEquiv`, retaining its generator and defining relation.
-/

public section

open Polynomial
open TauCeti.PowerSeries
namespace TauCeti.Examples.TateAlgebra

variable (R : Type*) [NormedCommRing R] [IsUltrametricDist R]

/-- Without variables, the unit-radius Tate algebra is the coefficient ring. -/
noncomputable def zeroVariablesEquiv :
    MvPowerSeries.IsRestricted.subring (R := R) (fun _ : PEmpty => (1 : ℝ)) ≃ₐ[R] R :=
  (AlgEquiv.ofBijective (Algebra.ofId R _)
    ⟨fun a b h => by
      have hcoeff := congrArg (fun f : MvPowerSeries.IsRestricted.subring (R := R)
        (fun _ : PEmpty => (1 : ℝ)) =>
          MvPowerSeries.constantCoeff (f : MvPowerSeries PEmpty R)) h
      simpa using hcoeff,
      MvPowerSeries.algebraMap_isRestrictedSubring_surjective⟩).symm

/-- The quotient by the degree-zero polynomial 1 is the zero ring. -/
theorem subsingleton_quotient_one : Subsingleton (PowerSeries.IsRestricted.subring (R := R) 1 ⧸
    Ideal.span {(1 : PowerSeries.IsRestricted.subring (R := R) 1)}) := by
  rw [Ideal.span_singleton_one]
  infer_instance

variable (K : Type*) [NormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-- Quotienting by a linear polynomial with root in the unit ball gives the coefficient field. -/
noncomputable def linearQuotientEquiv (a : K) (ha : ‖a‖ ≤ 1) :
    (PowerSeries.IsRestricted.subring (R := K) 1 ⧸
      Ideal.span {polynomialToRestricted 1 (X - C a)}) ≃ₐ[K] K := by
  have hd : IsDistinguished 1 1 ((X - C a : K[X]) : PowerSeries K) := by
    simpa using isDistinguished_X_sub_C zero_lt_one ha
  exact (hd.polynomialQuotientEquiv zero_lt_one (isMonicOfDegree_X_sub_one a)).symm.trans
    (Polynomial.quotientSpanXSubCAlgEquiv a)

/-- The linear quotient comparison sends the class of X to its prescribed root. -/
@[simp]
theorem linearQuotientEquiv_X (a : K) (ha : ‖a‖ ≤ 1) :
    linearQuotientEquiv K a ha
      (Ideal.Quotient.mk _ (polynomialToRestricted 1 (X : K[X]))) = a := by
  simp [linearQuotientEquiv]

/-- The unit-radius Tate algebra in one variable has dimension 1. -/
theorem dimension_one : ringKrullDim
    (MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Unit => (1 : ℝ))) = 1 := by
  simpa only [Nat.card_unique, Nat.cast_one] using
    (TauCeti.MvPowerSeries.ringKrullDim_isRestricted_subring (K := K) (σ := Unit))

/-- The quotient by `X - 1` has rank 1 over the coefficient field. -/
theorem finrank_quotient_X_sub_one : Module.finrank K (PowerSeries.IsRestricted.subring (R := K) 1 ⧸
    Ideal.span {polynomialToRestricted 1 (X - C (1 : K))}) = 1 := by
  rw [(linearQuotientEquiv K 1 (by simp)).toLinearEquiv.finrank_eq]
  exact Module.finrank_self K

variable (p : ℕ) [hp : Fact p.Prime]

/-- The polynomial `X² - p` is monic of degree 2. -/
private theorem quadratic_monic : (X ^ 2 - C (p : ℚ_[p])).IsMonicOfDegree 2 := by
  apply (isMonicOfDegree_X_pow ℚ_[p] 2).sub
  simp

/-- The polynomial `X² - p` is distinguished of degree 2 at radius 1. -/
private theorem quadratic_distinguished :
    IsDistinguished 1 2 ((X ^ 2 - C (p : ℚ_[p]) : (ℚ_[p])[X]) :
    PowerSeries ℚ_[p]) := by
  apply isDistinguished_of_isMonicOfDegree zero_lt_one
    ((isMonicOfDegree_X_pow ℚ_[p] 2).sub (by simp))
  intro k hk
  interval_cases k
  · simp only [coeff_sub, coeff_X_pow, OfNat.zero_ne_ofNat, ↓reduceIte, coeff_C_zero,
      zero_sub, norm_neg, pow_zero, mul_one, one_pow]
    exact (Padic.norm_p_lt_one (p := p)).le
  · simp

/-- The restricted-series quotient by `X² - p` agrees with its polynomial quotient. -/
private noncomputable def quadraticQuotientEquiv :
    AdjoinRoot (X ^ 2 - C (p : ℚ_[p])) ≃ₐ[ℚ_[p]]
      (PowerSeries.IsRestricted.subring (R := ℚ_[p]) 1 ⧸
        Ideal.span {polynomialToRestricted 1 (X ^ 2 - C (p : ℚ_[p]))}) :=
  (quadratic_distinguished p).polynomialQuotientEquiv zero_lt_one (quadratic_monic p)

/-- The quadratic restricted-series quotient has a power basis generated by the class of X. -/
private noncomputable def quadraticPowerBasis : PowerBasis ℚ_[p]
    (PowerSeries.IsRestricted.subring (R := ℚ_[p]) 1 ⧸
      Ideal.span {polynomialToRestricted 1 (X ^ 2 - C (p : ℚ_[p]))}) :=
  (AdjoinRoot.powerBasis (quadratic_monic p).monic.ne_zero).map (quadraticQuotientEquiv p)

/-- The quadratic quotient power basis has dimension 2. -/
private theorem quadraticPowerBasis_dim : (quadraticPowerBasis p).dim = 2 := by
  rw [quadraticPowerBasis, PowerBasis.map_dim, AdjoinRoot.powerBasis_dim]
  exact (quadratic_monic p).natDegree_eq

/-- The power-basis generator is the class of the restricted-series variable X. -/
private theorem quadraticPowerBasis_gen : (quadraticPowerBasis p).gen =
    Ideal.Quotient.mk _ (polynomialToRestricted 1 (X : (ℚ_[p])[X])) := by
  rw [quadraticPowerBasis, PowerBasis.map_gen, AdjoinRoot.powerBasis_gen]
  exact (quadratic_distinguished p).polynomialQuotientEquiv_mk
    zero_lt_one (quadratic_monic p) X

/-- The power-basis generator satisfies the relation X² = p. -/
private theorem quadraticPowerBasis_gen_sq :
    (quadraticPowerBasis p).gen ^ 2 = algebraMap ℚ_[p] _ p := by
  rw [quadraticPowerBasis, PowerBasis.map_gen, AdjoinRoot.powerBasis_gen, ← map_pow]
  have h : AdjoinRoot.root (X ^ 2 - C (p : ℚ_[p])) ^ 2 =
      algebraMap ℚ_[p] _ p := by
    have h := AdjoinRoot.eval₂_root (X ^ 2 - C (p : ℚ_[p]))
    simpa [sub_eq_zero] using h
  rw [h, AlgEquiv.commutes]

/-- A basis indexed by Fin 2 for the restricted-series quotient by X² - p. -/
noncomputable def quadraticBasis : Module.Basis (Fin 2) ℚ_[p]
    (PowerSeries.IsRestricted.subring (R := ℚ_[p]) 1 ⧸
      Ideal.span {polynomialToRestricted 1 (X ^ 2 - C (p : ℚ_[p]))}) :=
  (quadraticPowerBasis p).basis.reindex (finCongr (quadraticPowerBasis_dim p))

/-- The two basis vectors of the quadratic quotient are exactly 1 and the class of X. -/
@[simp]
theorem quadraticBasis_apply (i : Fin 2) : quadraticBasis p i =
    (Ideal.Quotient.mk _ (polynomialToRestricted 1 (X : (ℚ_[p])[X]))) ^ (i : ℕ) := by
  simp only [quadraticBasis, Module.Basis.reindex_apply, PowerBasis.basis_eq_pow,
    quadraticPowerBasis_gen]
  rfl

/-- The class of X in the quadratic restricted-series quotient satisfies X² = p. -/
theorem quadratic_X_sq :
    (Ideal.Quotient.mk
      (Ideal.span {polynomialToRestricted 1 (X ^ 2 - C (p : ℚ_[p]))})
      (polynomialToRestricted 1 (X : (ℚ_[p])[X]))) ^ 2 = algebraMap ℚ_[p] _ p := by
  rw [← quadraticPowerBasis_gen]
  exact quadraticPowerBasis_gen_sq p

end TauCeti.Examples.TateAlgebra
