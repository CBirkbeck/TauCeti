module

public import Mathlib.Topology.Spectral.Basic

/-!
# The patch criterion for spectral spaces

A T0 topology generated by a family of clopen subsets of a compact space is spectral. This is
the reusable criterion behind the spectrality of valuation spectra (Wedhorn, *Adic Spaces*,
arXiv:1910.05934v1, Proposition 3.31): a compact witness topology `t'` on `X` together with a
family `U` of `t'`-clopen sets generating a T0 topology `t = generateFrom U` produces a
spectral space, and the members of `U` are quasi-compact opens of `t`.

The ambient `TopologicalSpace X` instance plays the role of the generated topology, pinned by
the hypothesis `t = generateFrom U` in the style of
`TopologicalSpace.isTopologicalBasis_of_subbasis`; the compact witness topology `t'` is an
explicit second topology.

## Main results

* `TauCeti.spectralSpace_of_isClopen_generateFrom` : Wedhorn's Proposition 3.31.
* `TauCeti.isCompact_of_isClopen_generateFrom` : every member of `U` is quasi-compact for the
  generated topology.

## References

* T. Wedhorn, *Adic Spaces*, arXiv:1910.05934v1, Lemma 3.29 and Proposition 3.31.
-/

public section

namespace TauCeti

open TopologicalSpace Set Topology

variable {X : Type*} {U : Set (Set X)} {t' : TopologicalSpace X}

section TransferHelpers

/-- The topology generated by a family of `t'`-open sets is coarser than `t'`. -/
lemma le_generateFrom_of_isOpen (hU : ∀ s ∈ U, IsOpen[t'] s) : t' ≤ generateFrom U :=
  le_generateFrom hU

/-- A set compact for `t'` is compact for the coarser topology `generateFrom U` generated by
`t'`-open sets. -/
lemma isCompact_generateFrom_of_isOpen (hU : ∀ s ∈ U, IsOpen[t'] s) {s : Set X}
    (hs : @IsCompact _ t' s) : @IsCompact _ (generateFrom U) s := by
  have h : @Continuous X X t' (generateFrom U) id :=
    continuous_id_iff_le.mpr (le_generateFrom_of_isOpen hU)
  simpa [Set.image_id] using @IsCompact.image X X t' (generateFrom U) s id hs h

/-- A finite intersection of `t'`-clopen sets is `t'`-clopen. -/
private lemma isClopen_sInter_of_subset (hU : ∀ s ∈ U, @IsClopen X t' s) {f : Set (Set X)}
    (hf : f.Finite) (hfU : f ⊆ U) : @IsClopen X t' (⋂₀ f) := by
  rw [Set.sInter_eq_biInter]
  exact @Set.Finite.isClopen_biInter X t' (Set X) f hf id fun s hs ↦ hU s (hfU hs)

/-- A `t'`-closed set is `t'`-compact when `t'` is compact. -/
private lemma isCompact_patch_of_isClosed (hcomp : @CompactSpace X t') {s : Set X}
    (hs : @IsClosed X t' s) : @IsCompact X t' s :=
  @IsClosed.isCompact X t' s hcomp hs

end TransferHelpers

section Criterion

variable [t : TopologicalSpace X] (htU : t = generateFrom U)
  (hcomp : @CompactSpace X t') (hU : ∀ s ∈ U, @IsClopen X t' s)

include htU hcomp hU

omit hcomp in
/-- A set compact for the witness topology `t'` is compact for the generated topology. -/
private lemma isCompact_of_patch {s : Set X} (hs : @IsCompact X t' s) : IsCompact s := by
  subst htU
  exact isCompact_generateFrom_of_isOpen (fun u hu ↦ (hU u hu).isOpen) hs

/-- The generated topology of a compact patch presentation is compact. -/
lemma compactSpace_of_isClopen_generateFrom : CompactSpace X :=
  ⟨isCompact_of_patch htU hU hcomp.isCompact_univ⟩

/-- Every member of `U` is quasi-compact for the generated topology. -/
lemma isCompact_of_isClopen_generateFrom {s : Set X} (hs : s ∈ U) : IsCompact s :=
  isCompact_of_patch htU hU
    (isCompact_patch_of_isClosed hcomp (@IsClopen.isClosed X t' s (hU s hs)))

/-- Every finite intersection of members of `U` is quasi-compact for the generated topology. -/
private lemma isCompact_sInter_of_patch {f : Set (Set X)} (hf : f.Finite) (hfU : f ⊆ U) :
    IsCompact (⋂₀ f) :=
  isCompact_of_patch htU hU
    (isCompact_patch_of_isClosed hcomp
      (@IsClopen.isClosed X t' _ (isClopen_sInter_of_subset hU hf hfU)))

omit hcomp hU in
/-- The finite intersections of members of `U` form a basis of the generated topology. -/
private lemma isTopologicalBasis_sInter_of_patch :
    IsTopologicalBasis ((fun f ↦ ⋂₀ f) '' { f : Set (Set X) | f.Finite ∧ f ⊆ U }) :=
  isTopologicalBasis_of_subbasis htU

/-- The generated topology of a compact patch presentation is prespectral. -/
lemma prespectralSpace_of_isClopen_generateFrom : PrespectralSpace X := by
  refine .of_isTopologicalBasis (isTopologicalBasis_sInter_of_patch htU) ?_
  rintro _ ⟨f, ⟨hf, hfU⟩, rfl⟩
  exact isCompact_sInter_of_patch htU hcomp hU hf hfU

omit hcomp in
/-- A quasi-compact open of the generated topology is clopen for the witness topology: it is a
finite union of finite intersections of members of `U`. -/
private lemma isClopen_patch_of_isCompact_isOpen {V : Set X} (hV : IsCompact V)
    (hVo : IsOpen V) : @IsClopen X t' V := by
  obtain ⟨S, hSB, hVS⟩ := (isTopologicalBasis_sInter_of_patch htU).open_eq_sUnion hVo
  obtain ⟨T, hT⟩ := hV.elim_finite_subcover (fun s : S ↦ (s : Set X))
    (fun s ↦ (isTopologicalBasis_sInter_of_patch htU).isOpen (hSB s.2))
    ((hVS.trans Set.sUnion_eq_iUnion).le)
  have hVT : V = ⋃ s ∈ T, (s : Set X) :=
    Set.Subset.antisymm hT
      (Set.iUnion₂_subset fun s _ ↦ (Set.subset_sUnion_of_mem s.2).trans hVS.ge)
  rw [hVT]
  refine @isClopen_biUnion_finset X t' ↥S T _ fun s _ ↦ ?_
  obtain ⟨f, ⟨hf, hfU⟩, hs⟩ := hSB s.2
  exact hs ▸ isClopen_sInter_of_subset hU hf hfU

/-- The generated topology of a compact patch presentation is quasi-separated. -/
lemma quasiSeparatedSpace_of_isClopen_generateFrom : QuasiSeparatedSpace X := by
  refine ⟨fun V W hVo hVc hWo hWc ↦ ?_⟩
  refine isCompact_of_patch htU hU ?_
  have h : @IsClopen X t' (V ∩ W) :=
    @IsClopen.inter X t' V W (isClopen_patch_of_isCompact_isOpen htU hU hVc hVo)
      (isClopen_patch_of_isCompact_isOpen htU hU hWc hWo)
  exact isCompact_patch_of_isClosed hcomp (@IsClopen.isClosed X t' _ h)

omit htU hcomp hU in
/-- An irreducible set meets every finite intersection of open sets that it meets. -/
private lemma nonempty_inter_biInter_of_isIrreducible {Z : Set X} (hZ : IsIrreducible Z)
    {ι : Type*} (T : Finset ι) (f : ι → Set X) (hf : ∀ i ∈ T, IsOpen (f i))
    (hne : ∀ i ∈ T, (Z ∩ f i).Nonempty) : (Z ∩ ⋂ i ∈ T, f i).Nonempty := by
  classical
  induction T using Finset.induction_on with
  | empty => simpa using hZ.nonempty
  | insert a T ha ih =>
    rw [Finset.set_biInter_insert]
    exact hZ.2 (f a) (⋂ i ∈ T, f i) (hf a (Finset.mem_insert_self a T))
      (isOpen_biInter_finset fun i hi ↦ hf i (Finset.mem_insert_of_mem hi))
      (hne a (Finset.mem_insert_self a T))
      (ih (fun i hi ↦ hf i (Finset.mem_insert_of_mem hi))
        fun i hi ↦ hne i (Finset.mem_insert_of_mem hi))

omit t htU hcomp in
/-- Basis elements of the patch presentation are clopen for the witness topology. -/
private lemma isClopen_patch_of_mem_basis {b : Set X}
    (hb : b ∈ (fun f ↦ ⋂₀ f) '' { f : Set (Set X) | f.Finite ∧ f ⊆ U }) :
    @IsClopen X t' b := by
  obtain ⟨f, ⟨hf, hfU⟩, rfl⟩ := hb
  exact isClopen_sInter_of_subset hU hf hfU

/-- The generated topology of a compact patch presentation is quasi-sober: an irreducible
closed set is covered by the patch-open complements of basic opens avoiding each of its
points, so patch compactness produces a finite subcover contradicting irreducibility unless
some point is generic. This is the argument of Wedhorn, Lemma 3.29. -/
lemma quasiSober_of_isClopen_generateFrom : QuasiSober X := by
  refine ⟨fun {Z} hZ hZc ↦ ?_⟩
  by_contra hng
  rw [not_exists] at hng
  -- for every point of `Z` there is a basic open meeting `Z` but avoiding the point
  have key : ∀ z : Z, ∃ b ∈ (fun f ↦ ⋂₀ f) '' { f : Set (Set X) | f.Finite ∧ f ⊆ U },
      (z : X) ∉ b ∧ (Z ∩ b).Nonempty := by
    rintro ⟨z, hz⟩
    have hnsub : ¬ Z ⊆ closure {z} := fun hsub ↦
      hng z (subset_antisymm (closure_minimal (Set.singleton_subset_iff.mpr hz) hZc) hsub)
    obtain ⟨w, hwZ, hwn⟩ := Set.not_subset.mp hnsub
    obtain ⟨b, hb, hwb, hbV⟩ :=
      (isTopologicalBasis_sInter_of_patch htU).exists_subset_of_mem_open hwn
        isClosed_closure.isOpen_compl
    exact ⟨b, hb, fun hzb ↦ hbV hzb (subset_closure (Set.mem_singleton z)), w, hwZ, hwb⟩
  choose b hbmem hbz hbne using key
  -- `Z` is closed, hence compact, for the witness topology
  have hZc' : @IsClosed X t' Z := by
    have hle : t' ≤ t := htU ▸ le_generateFrom_of_isOpen fun s hs ↦
      @IsClopen.isOpen X t' s (hU s hs)
    exact (@isOpen_compl_iff X Z t').mp (hZc.isOpen_compl.mono hle)
  have hZcomp : @IsCompact X t' Z := isCompact_patch_of_isClosed hcomp hZc'
  -- extract a finite subcover of `Z` by complements of the chosen basic opens
  obtain ⟨T, hT⟩ := @IsCompact.elim_finite_subcover X t' Z Z hZcomp (fun z ↦ (b z)ᶜ)
    (fun z ↦ @IsClopen.isOpen X t' _ (@IsClopen.compl X t' _ (isClopen_patch_of_mem_basis
      hU (hbmem z))))
    (fun x hx ↦ Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hbz ⟨x, hx⟩⟩)
  -- the basic opens all meet the irreducible `Z`, so their finite intersection meets `Z`
  obtain ⟨x, hxZ, hxB⟩ := nonempty_inter_biInter_of_isIrreducible hZ T b
    (fun z _ ↦ (isTopologicalBasis_sInter_of_patch htU).isOpen (hbmem z)) fun z _ ↦ hbne z
  obtain ⟨z, hzT, hxz⟩ := Set.mem_iUnion₂.mp (hT hxZ)
  exact hxz (Set.mem_iInter₂.mp hxB z hzT)

/-- **Wedhorn, Proposition 3.31** (*Adic Spaces*, arXiv:1910.05934v1): a T0 topology generated
by a family of clopen subsets of a compact space is spectral. -/
theorem spectralSpace_of_isClopen_generateFrom [T0Space X] : SpectralSpace X where
  toCompactSpace := compactSpace_of_isClopen_generateFrom htU hcomp hU
  toQuasiSober := quasiSober_of_isClopen_generateFrom htU hcomp hU
  toQuasiSeparatedSpace := quasiSeparatedSpace_of_isClopen_generateFrom htU hcomp hU
  toPrespectralSpace := prespectralSpace_of_isClopen_generateFrom htU hcomp hU

end Criterion

end TauCeti
